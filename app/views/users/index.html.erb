<h1><%= t('.title') %></h1>

<div id="users" class="index-items">
  <% @users.each do |user| %>
    <div class="index-item">
      <p><%= User.human_attribute_name(:email) %>: <%= user.email %></p>
      <p><%= User.human_attribute_name(:address) %>: <%= user.address %></p>
      <p><%= link_to t('.show'), user %></p>
    </div>
  <% end %>
</div>

<%= paginate @users %>
