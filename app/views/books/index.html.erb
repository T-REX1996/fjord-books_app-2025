<p style="color: green"><%= notice %></p>

<% content_for :title, t(".title", model: Book.model_name.human) %>

<h1><%= t(".title", model: Book.model_name.human) %></h1>

<div id="books" class="index-items">
  <% @books.each do |book| %>
    <div class="index-item">
      <%= render book %>
      <p>
        <%= link_to t("actions.show", model: Book.model_name.human), book %>
      </p>
    </div>
  <% end %>
</div>

<nav class="page-nav">
  <%= link_to t("actions.new", model: Book.model_name.human), new_book_path %>
</nav>
